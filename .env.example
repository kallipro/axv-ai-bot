# 1. Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=

# 2. Google Gemini API Kaliti (https://aistudio.google.com/app/apikey dan olinadi)
GEMINI_API_KEY=

# 3. Gemini modeli (eng so'nggi Gemini 3.8 Flash modeli)
GEMINI_MODEL=gemini-3.8-flash

# 4. Admin Telegram ID lari (ixtiyoriy, vergul bilan ajratilgan)
ADMIN_IDS=
